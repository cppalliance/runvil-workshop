/.model-cache/
/target
/vibe-review.md
/conformance-audit.md
/local/
*.env
# Standing guard: the operator's real secrets file must never be tracked.
/secrets.env
# UI build pipeline: npm install target and the esbuild output. The build
# scripts write the bundle to OUT_DIR; `npm run build`/`--watch` still write
# dist/ in place for the jsdom tests, and none of it is tracked.
/crates/workshop/**/node_modules/
/crates/workshop/ui/dist/
# tauri-build's generated ACL schemas, regenerated on every workshop build.
/crates/workshop/desktop/gen/
# The Windows gateway sidecar staged for bundle.externalBin before
# `tauri build` (crates/workshop/desktop/tauri.windows.conf.json); a build
# artifact.
/crates/workshop/desktop/binaries/
